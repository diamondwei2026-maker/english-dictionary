# ============================================
# English Dictionary — 环境变量配置
# ============================================
# 复制本文件为 .env，按实际环境修改值
#   cp .env.example .env
# ============================================

# ---- 基础配置 ----

# 服务端口（默认 3001）
PORT=3001

# 运行环境：development | production
NODE_ENV=production

# ---- 数据库 ----

# MongoDB 连接字符串（必填）
# Docker 环境：mongodb://mongodb:27017/english-dictionary
# 本地开发：mongodb://localhost:27017/english-dictionary
MONGODB_URI=mongodb://localhost:27017/english-dictionary

# MongoDB 连接池配置（可选）
# DB_MAX_POOL_SIZE=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000

# ---- JWT 认证 ----

# ⚠️ 生产环境必须修改为安全的随机字符串！
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production

# Access Token 有效期（默认 7 天）
JWT_EXPIRES_IN=7d

# Refresh Token 有效期（默认 7 天）
JWT_REFRESH_EXPIRES_IN=7d

# ---- AI 词条生成（DeepSeek） ----

# DeepSeek API 密钥（可选，AI 生成功能需要）
DEEPSEEK_API_KEY=

# DeepSeek API 地址（默认 https://api.deepseek.com/v1）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- 缓存 ----

# 是否启用结果缓存（默认 true）
CACHE_ENABLED=true

# 各类缓存 TTL（秒）
# CACHE_TTL_DAILY_WORD=86400
# CACHE_TTL_WORDBANK_LIST=300
# CACHE_TTL_WORDBANK_DETAIL=300
# CACHE_TTL_WORD_DETAIL=600
# CACHE_TTL_WORD_LIST=300

# ⚠️ 生产环境请务必修改 JWT_SECRET 为安全的随机字符串
