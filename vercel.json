{
  "framework": null,
  "buildCommand": "cd client && pnpm install --frozen-lockfile && pnpm build:h5",
  "outputDirectory": "client/dist/build/h5",
  "installCommand": "",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://english-dictionary-api-q9e3.onrender.com/api/:path*"
    },
    {
      "source": "/api/docs/:path*",
      "destination": "https://english-dictionary-api-q9e3.onrender.com/api/docs/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
