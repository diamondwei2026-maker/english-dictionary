{
  "name": "english-dictionary-server",
  "version": "1.0.0",
  "description": "英语母语者词典 — 后端 API 服务",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "test": "jest --passWithNoTests",
    "db:init": "tsx src/seed/index.ts",
    "db:seed": "tsx src/seed/index.ts",
    "db:clean": "tsx -e \"const mongoose = require('mongoose'); require('dotenv').config(); mongoose.connect(process.env.MONGODB_URI).then(() => Promise.all([mongoose.connection.dropCollection('users'), mongoose.connection.dropCollection('words'), mongoose.connection.dropCollection('wordbanks')])).then(() => { console.log('All collections dropped'); process.exit(0); }).catch((err) => { console.error(err.message); process.exit(1); })\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.36",
    "tsx": "^4.15.0",
    "typescript": "^7.0.2"
  }
}
